{
  "name": "@catbee/mysql",
  "version": "0.1.0",
  "description": "Production-ready, type-safe MySQL client for Node.js with transactions, pooling, query builder, and named parameters.",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "author": "Hari G <harig@catbee.in>",
  "maintainers": [
    "Hari G <harig@catbee.in>",
    "Bavi R <bavithra@catbee.in>"
  ],
  "homepage": "https://catbee.in/docs/@catbee/mysql/intro",
  "repository": {
    "type": "git",
    "url": "https://github.com/catbee-technologies/catbee-mysql.git"
  },
  "bugs": {
    "url": "https://github.com/catbee-technologies/catbee-mysql/issues"
  },
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "prepare:husky": "husky",
    "prepack": "npm run build",
    "compile": "tsup",
    "clean": "rimraf dist",
    "build": "npm run compile && npm run postbuild",
    "build:clean": "npm run clean && npm run build",
    "build:start": "npm run build && node dist/index.cjs && node dist/index.mjs",
    "postbuild": "node scripts/add-license.mjs && node scripts/post-build.mjs",
    "lint": "eslint src tests",
    "lint:fix": "eslint --fix src tests",
    "preversion": "npm run lint && npm run build:start && npm run test",
    "dryrun": "npm pack --dry-run",
    "dryrun:list": "npm pack --dry-run --json > pack-output.json",
    "test": "cross-env TZ=UTC jest",
    "test:coverage": "cross-env TZ=UTC jest --coverage",
    "coverage": "npm run test:coverage",
    "deps:update": "npx npm-check-updates -u --target latest && npm install"
  },
  "dependencies": {
    "mysql2": "^3.24.5"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "jest-sonar-reporter": "^2.0.0",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.14",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "engines": {
    "node": ">=18.4"
  }
}
