{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:monorepos"],
  "timezone": "UTC",
  "prHourlyLimit": 5,
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "groupName": "npm breaking updates"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm non-breaking updates"
    },
    {
      "groupName": "eslint packages",
      "matchPackageNames": [
        "eslint**",
        "@eslint/**",
        "@typescript-eslint/**",
        "typescript-eslint",
        "eslint-**"
      ]
    },
    {
      "groupName": "jest packages",
      "matchPackageNames": ["jest**", "ts-jest", "@types/jest", "@jest/**"]
    },
    {
      "groupName": "catbee packages",
      "matchPackageNames": ["@catbee/**"]
    },
    {
      "groupName": "ng catbee packages",
      "matchPackageNames": ["@ng-catbee/**"]
    }
  ],
  "addLabels": ["type: dependencies", "status: needs-review"],
  "reviewers": ["catbee-technologies/catbee-admins"],
  "branchPrefix": "dependency/",
  "rangeStrategy": "bump",
  "rebaseWhen": "behind-base-branch",
  "baseBranchPatterns": ["main"],
  "dependencyDashboard": true,
  "lockFileMaintenance": {
    "enabled": true
  },
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "commitMessageLowerCase": "auto",
  "ignoreDeps": [],
  "enabledManagers": ["npm"]
}